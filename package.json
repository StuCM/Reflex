{
  "name": "reflex",
  "version": "0.0.2",
  "private": true,
  "description": "Browse-fast Plex client for an LG OLED B8 (webOS 4.0)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env dev/server.js",
    "beacon": "node dev/beacon.js",
    "fixture": "node dev/make-fixture.js",
    "test": "node test/run.js",
    "check": "node tools/check-es5.js",
    "smoke": "node dev/smoke.js",
    "verify": "npm run check && npm run lint && npm run lint:css && npm run format:check && npm run typecheck && npm test && npm run fixture && npm run smoke",
    "package": "sh tools/package.sh",
    "prepare": "node .claude/crew/bin/setup.js",
    "crew:setup": "git config core.hooksPath .claude/crew/githooks && echo 'commit hook enabled'",
    "crew:board": "node .claude/crew/bin/board.js",
    "crew:scope": "node .claude/crew/bin/scope-check.js",
    "crew:preflight": "node .claude/crew/bin/preflight.js",
    "deploy": "npm run check && npm run package && ares-install -d ${TV:-tv} *.ipk && ares-launch -d ${TV:-tv} com.stu.plexlite",
    "lint": "oxlint",
    "lint:css": "stylelint \"css/**/*.css\"",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.8",
    "eslint-plugin-unicorn": "^74.0.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "stylelint": "^17.15.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome 53"
  ]
}
