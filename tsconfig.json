{
  "compilerOptions": {
    "target": "ES2020",

    // Not the build target — Vite/Oxc lowers syntax to chrome53. This is the
    // *library* surface, and holding it at ES2015 is what makes `Object.entries`
    // (Chrome 54), `padStart` (57) and `Promise.finally` (63) type errors rather
    // than a black screen on the panel. Anything Chromium 53 has but ES2015 does
    // not goes in types/chrome53.d.ts, one declaration at a time, with evidence.
    "lib": ["ES2015", "DOM"],

    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts", "*.config.ts"]
}
