{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "import", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": { "browser": true, "es2015": true },
  "ignorePatterns": [
    "node_modules",
    "build",
    "dist",
    "dev/fixtures",
    // Generated by dc-runtime; its header says do not edit.
    "design",
    ".claude"
  ],
  "rules": {
    // Chromium 53 has no Array#toSorted — that is Chrome 110. Following this
    // rule inside js/ ships a TV that cannot sort. The same shape as Lightning
    // CSS lowering clamp() to min()/max(): a tool recommending a newer API
    // than the target has.
    "unicorn/no-array-sort": "off",

    // This codebase keeps a helper next to its only caller on purpose, and
    // CLAUDE.md's "match the file you are in" says to keep doing it. Hoisting
    // them to module scope to save a closure allocation trades locality for
    // an amount of time nothing here can measure.
    "unicorn/consistent-function-scoping": "off",

    // XHR, IndexedDB, FileReader and the media element are all driven by
    // single `on<event>` handlers here, which is how their own specs read.
    // addEventListener buys nothing where a second handler is never added.
    "unicorn/prefer-add-event-listener": "off",

    // A formatter cannot re-wrap a string literal, so splitting a long HTML or
    // SVG string across `+` is the only way to keep it inside printWidth.
    // Joining them, as this rule asks, produced 135-character lines that oxfmt
    // then had to leave alone. The concatenation is layout, not an accident.
    "no-useless-concat": "off",

    // `_server`, `_sources`, `_tmdb`, `_asking` are the documented convention
    // for "this app put it there, the server did not" — see CLAUDE.md.
    "no-underscore-dangle": "off",

    // A module binding (`var Media = …`) looks unused because every consumer
    // reaches it through the global object. Real once js/ is ESM; until then
    // only lower-case locals are worth checking.
    "no-unused-vars": ["error", { "varsIgnorePattern": "^[A-Z]", "caughtErrors": "none" }],

    // `properties: never` because the short names left are data, not choices:
    // certificate codes (u, g, r, x), language codes, codec names.
    "id-length": [
      "error",
      {
        "min": 3,
        "exceptions": ["i", "j", "id", "at", "to", "UI", "T", "K"],
        "properties": "never"
      }
    ],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "import/no-cycle": "error",

    // Ratchets. Set at today's worst so nothing is blocked on day one; every
    // merge may lower a number, none may raise one. Measured AFTER oxfmt:
    // one property per line grew player.js from 1221 to 1508.
    "max-lines": ["error", { "max": 1513 }],
    "max-lines-per-function": ["error", { "max": 117 }],
    "max-depth": ["error", 4],
    "complexity": ["error", 35]
  },
  "overrides": [
    {
      // The entry is side-effect imports by design: each legacy module still
      // publishes itself on `window` and is imported for that, not for a value.
      // Every line here disappears as its file becomes a real module.
      "files": ["src/main.ts", "test/modules.ts"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      // Not shipped to the TV: modern Node, and none of the size ratchets.
      "files": ["dev/**", "tools/**", "test/**", "*.config.*", "probe.py"],
      "rules": {
        "id-length": "off",
        "max-lines": "off",
        "max-lines-per-function": "off",
        "complexity": "off",
        "max-depth": "off",
        "unicorn/no-array-sort": "off"
      }
    },
    {
      // THE MIGRATION RATCHET. Every layer still written as global scripts
      // sits here. As each is converted to ESM + TypeScript (see
      // docs/refactor-plan.md) delete its line, and the strict rules start
      // applying to it. When this list is empty, so is the migration.
      "files": ["js/core/**", "js/api/**", "js/data/**", "js/view/**", "js/screen/**", "js/app.js"],
      "rules": {
        "id-length": "off",
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
